{
  "compilerOptions": {
    "target": "es2023",
    "rootDir": "./src",
    "outDir": "./build",
    "tsBuildInfoFile": "./build/.tsbuildinfo",
    "module": "nodenext",
    "esModuleInterop": true,
    "removeComments": true,
    "strict": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "incremental": true,
    "moduleResolution": "nodenext",
    "lib": [
      "esnext"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "failures",
    "node_modules"
  ]
}
