{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["esnext"],
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./build",
    "tsBuildInfoFile": "./build/.tsbuildinfo",
    "module": "nodenext",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "strict": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "incremental": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
