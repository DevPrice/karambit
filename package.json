{
  "name": "karambit-inject",
  "version": "4.1.3",
  "description": "A compile-time and type-safe dependency injector for Typescript.",
  "keywords": [
    "dependency injection",
    "di",
    "ioc",
    "inject"
  ],
  "exports": {
    ".": "./build/karambit.js"
  },
  "bin": {
    "karambit": "bin/index.js"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "LICENSE.txt",
    "bin/**/*.js",
    "build/*.d.ts",
    "build/**/*.js"
  ],
  "scripts": {
    "prepare": "husky install",
    "clean": "rm -rf build",
    "karambit": "node build/cli.js . -o src/karambit-generated/karambit.ts",
    "build": "tsc",
    "test": "npm run typecheck && vitest run && npm run --prefix integration build && npm run --prefix integration test",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check": "npm run test",
    "prerelease": "npm run clean",
    "release": "npm run build && npm run karambit && npm run build && npm run --prefix decorators build && npm run check",
    "prerelease-version": "version-from-git --no-git-tag-version --no-commit-hooks",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "author": "DevPrice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevPrice/karambit.git"
  },
  "bugs": "https://github.com/DevPrice/karambit/issues",
  "dependencies": {
    "chalk": "^4.1.2",
    "picomatch": "^4.0.3",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@devprice/eslint-config": "^1.1.2",
    "@types/node": "^24.13.3",
    "@types/picomatch": "^4.0.2",
    "@types/yargs": "^17.0.35",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "husky": "^8.0.1",
    "karambit-inject": "^4.1.3",
    "lint-staged": "^15.2.10",
    "typescript": "^7.0.2",
    "version-from-git": "^1.1.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": ">= 7.0.0"
  },
  "type": "module"
}
